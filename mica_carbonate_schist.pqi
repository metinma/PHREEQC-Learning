  10  Fe = tot("Fe")
20  if (Fe <= 0) then goto 200
30 k1 = 2.8184e-05   # # Specific rate constant Pyrite k,  k = 2.8184e-05 mol/m2/s (25 C)
40 E = 57e3   # activation energy J mole-1.
50 R = 8.3145     # gas constant  J mole-1 Kelvin-1
60 k2 = k1*exp(E/R*(1/TK - 1/298.15))  # Specific rate constant respect to temperature k
70 rate = (A0 / V)*(m/m0)^(2/3)* k2 * (1 - SR("Pyrite")) # SR=saturation ratio =(ion activity product/ equilibrium constant) with transition-state theory
80 moles = rate * time
90 if (moles < 0) then goto 200
200 SAVE moles
 -end
 

# 
Montmor-Ca
  -start
   1 A0 = parm(1)
   2 V = parm(2)
  # dCa / dt = (A0 / V) * (m / m0)^(2/3) * k * (1 - SI_Ca-Montmorillonite) 
   10  Ca = tot("Ca")
 20  if (Ca <= 0) then goto 200
 30 k1 = 1.6596e-14   # Specific rate constant  Montmor-Ca k,  k = 10.1^-14 mol/m2/s (25 C)
 40 E = 35e3   # activation energy J mole-1.
 50 R = 8.3145     # gas constant  J mole-1 Kelvin-1
 60 k2 = k1*exp(E/R*(1/TK - 1/298.15))  # Specific rate constant respect to temperature k
 70 rate = (A0 / V)*(m/m0)^(2/3)* k2 * (1 - SR("Montmor-Ca")) # SR=saturation ratio =(ion activity product/ equilibrium constant) with transition-state theory
 80 moles = rate * time
 90 if (moles < 0) then goto 200
 200 SAVE moles
  -end 



# 
Montmor-Na
  -start
   1 A0 = parm(1)
   2 V = parm(2)
  # dCa / dt = (A0 / V) * (m / m0)^(2/3) * k * (1 - SI_Na-Montmorillonite) 
   10  Mg = tot("Mg")
 20  if (Mg <= 0) then goto 200
 30 k1 = 1.6596e-14  # Specific rate constant  Montmor-Na k,  k = 10.1^-14 mol/m2/s (25 C)
 40 E = 35e3   # activation energy J mole-1.
 50 R = 8.3145     # gas constant  J mole-1 Kelvin-1
 60 k2 = k1*exp(E/R*(1/TK - 1/298.15))  # Specific rate constant respect to temperature k
 70 rate = (A0 / V)*(m/m0)^(2/3)* k2 * (1 - SR("Montmor-Na")) # SR=saturation ratio =(ion activity product/ equilibrium constant) with transition-state theory
 80 moles = rate * time
 90 if (moles < 0) then goto 200
