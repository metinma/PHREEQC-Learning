  -end 

 # 
Epidote-ord
  -start
   1 A0 = parm(1)
   2 V = parm(2)
  # dCa / dt = (A0 / V) * (m / m0)^(2/3) * k * (1 - SI_Andalusite) 
   10  Fe = tot("Fe")
 20  if (Fe <= 0) then goto 200
 30 k1 = 1e-12  # Specific rate constant k,  k = 10.1^-14 mol/m2/s (25 C)
 40 E = 70.7e3   # activation energy J mole-1.
 50 R = 8.3145     # gas constant  J mole-1 Kelvin-1
 60 k2 = k1*exp(E/R*(1/TK - 1/298.15))  # Specific rate constant respect to temperature k
 70 rate = (A0 / V)*(m/m0)^(2/3)* k2 * (1 - SR("Epidote-ord")) # SR=saturation ratio =(ion activity product/ equilibrium constant) with transition-state theory
 80 moles = rate * time
