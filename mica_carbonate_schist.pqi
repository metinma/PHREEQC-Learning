  10  Fe = tot("Fe")
20  if (Fe <= 0) then goto 200
30 k1 = 2.5e-15    # # Specific rate constant Hematite k,  k = 2.5119E-15 mol/m2/s (25 C)
40 E = 66e3   # activation energy J mole-1.
50 R = 8.3145     # gas constant  J mole-1 Kelvin-1
60 k2 = k1*exp(E/R*(1/TK - 1/298.15))  # Specific rate constant respect to temperature k
70 rate = (A0 / V)*(m/m0)^(2/3)* k2 * (1 - SR("Hematite")) # SR=saturation ratio =(ion activity product/ equilibrium constant) with transition-state theory
80 moles = rate * time
90 if (moles < 0) then goto 200
200 SAVE moles
 -end
 
  #  
Pyrite
