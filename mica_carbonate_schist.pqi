#############################################
# 8) Output 
#############################################
# ----------- Output & Graphs  -----------
SELECTED_OUTPUT
 -file Mica_carbonate_schist_simulation_results.txt 
 -reset true
 -high_precision true
 -user_punch true
USER_PUNCH
 -headings time_d pH Ptot_atm pH2_atm pCO2_atm pCH4_atm H2_g_mol CO2_g_mol CH4_g_mol SO4_mol Formate Acetate Ca_mol Fe_mol X_SRB_mol X_IRB_mol X_SRB_mol_per_L Fe(OH)3 SR_H2 SR_FOR SR_AC Montmor-Ca Montmor-Na Water_VOL Gas_VOL HS-_mol
-start
10 t_d = TOTAL_TIME/86400.0
20 x_srb   = KIN("X_SRB")               # mol
30 x_irb   = KIN("X_IRB")               # mol (0 if not present)
40 x_srb_L = x_srb / SOLN_VOL           # mol/L
50 Ptot = PR_P("CO2(g)") + PR_P("Mtg(g)") + PR_P("Hdg(g)") + PR_P("H2S(g)") + PR_P("Ntg(g)")
55 n_gas = GAS("Hdg(g)") + GAS("CO2(g)") + GAS("Mtg(g)") + GAS("Ntg(g)") + GAS("H2S(g)")+ GAS("Ntg(g)")
56 Vgas_L = n_gas * GAS_VM
60 PUNCH t_d, -LA("H+"), Ptot, PR_P("Hdg(g)"), PR_P("CO2(g)"), PR_P("Mtg(g)"), GAS("Hdg(g)"), GAS("CO2(g)"), GAS("Mtg(g)"), TOT("S(6)"), TOT("Formate"), TOT("Acetate"), TOT("Ca"), TOT("Fe(2)"), x_srb, x_irb, x_srb_L, EQUI("Fe(OH)3(a)"), KIN("SR_H2"), KIN("SR_FOR"), KIN("SR_AC"), KIN("Montmor-Ca"), KIN("Montmor-Na") SOLN_VOL, Vgas_L, MOL("HS-")
-end


USER_GRAPH 1
 -headings Time_d pH
 -chart_title "pH"
 -axis_titles "Time (days)" "pH"
 -plot_concentration_vs x
-start
10 GRAPH_X TOTAL_TIME/86400.0
20 GRAPH_Y -LA("H+")
-end

USER_GRAPH 2 # H2(g): model vs experiment
 -headings time_d H2(g) CO2(g) SO4 Formate Acetate Ca
  -chart_title "Mica_carbonate_schist model"
  -axis_titles "Time (days)" "H2 in headspace (mmol)"
  -plot_concentration_vs time
  # Add the external TSV file (first column = time_d). This will add all series,
  # modify the path below where you run your pheeqc model and the reading text file
-start
10  td = TOTAL_TIME/86400.0
20  GRAPH_X td
30 GRAPH_Y GAS("Hdg(g)")*1000                   # converted mol to mmol
40 GRAPH_Y (GAS("CO2(g)"))*1000  # converted mol to mmol
50 GRAPH_Y MOL("SO4-2")*1000                   # converted mol to mmol
60 GRAPH_Y TOT("Formate")*1000           # converted mol to mmol
70 GRAPH_Y TOT("Acetate")*1000            # converted mol to mmol
80 GRAPH_Y MOL("Ca+2")*1000                  # converted mol to mmol
-end


USER_GRAPH 3 Montmorillonite replenishment
  -headings Time_d Montmor-Ca_mol Montmor-Na_mol Calcite_mol
  -chart_title "Montmorillonite replenishment and Calcite"
  -axis_titles "Time (days)" "Moles"
  -plot_concentration_vs x
  -connect_simulations true
  -start
10 GRAPH_X  TOTAL_TIME/86400.0     # time in days
20 GRAPH_Y  KIN("Montmor-Ca")           # Montmor-Ca replenishment
25 GRAPH_Y  KIN("Montmor-Na")           # Montmor-Na replenishment
30 GRAPH_Y  KIN("Calcite")           # Calcite
  -end
  
  USER_GRAPH 4 Biomass growth
  -headings Time_d X_SRB_mol X_IRB_mol
  -chart_title "Biomass (moles of kinetic reactant)"
  -axis_titles "Time (days)" "Moles"
  -plot_concentration_vs x
  -connect_simulations true
  -start
10 GRAPH_X  TOTAL_TIME/86400.0     # time in days
20 GRAPH_Y  KIN("X_SRB")           # SRB biomass (mol)
30 GRAPH_Y  KIN("X_IRB")           # Fe-reducer biomass (mol)
  -end
 
USER_GRAPH 5 # H2(g): model vs experiment
 -headings time_d  Ca_model Fe_model HS-
  -chart_title "Ca Fe HS-"
  -axis_titles "Time (days)" " (mmol)"
  -plot_concentration_vs time

-start
10  td = TOTAL_TIME/86400.0
20  GRAPH_X td
30 GRAPH_Y TOT("Ca(2)")*1000                  # converted mol to mmol
40 GRAPH_Y TOT("Fe(2)")*1000                  # converted mol to mmol
50 GRAPH_Y MOL("HS-")*1000
-end 
  
 USER_GRAPH 6 Iron reduction
  -headings Time_d IR_H2 IR_AC IR_FOR  
  -chart_title "Iron reduction"
  -axis_titles "Time (days)" "Kinetics"
  -plot_concentration_vs x
  -connect_simulations true
  -start
10 GRAPH_X  TOTAL_TIME/86400.0     # time in days
20 GRAPH_Y  KIN("IR_H2")           
30 GRAPH_Y  KIN("IR_AC")     
40 GRAPH_Y  KIN("IR_FOR")        
  -end
END
